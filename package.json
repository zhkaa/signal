{
  "name": "signal-obsidia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "node --watch --env-file-if-exists=.env scripts/dev.mjs",
    "pretest": "npm run build",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "alpinejs": "^3.14.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "htmx.org": "^2.0.7",
    "lucide-static": "^1.52.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
